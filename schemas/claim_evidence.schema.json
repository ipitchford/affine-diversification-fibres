{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/claim_evidence.schema.json",
  "title": "Claim-to-evidence index",
  "type": "object",
  "required": [
    "schema_version",
    "release",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "release": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "type",
          "scope",
          "evidence",
          "assurance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "role"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "locator": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "assurance": {
            "type": "object"
          },
          "open_risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
