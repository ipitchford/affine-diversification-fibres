{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/assurance.schema.json",
  "title": "Scoped assurance matrix",
  "type": "object",
  "required": [
    "schema_version",
    "release",
    "scale",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "release": {
      "type": "string"
    },
    "scale": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "status",
          "scope",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "partial",
              "failed",
              "not_assessed",
              "not_applicable"
            ]
          },
          "scope": {
            "type": "string"
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
